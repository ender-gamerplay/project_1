class SoundGenerator:
    """Генерирует WAV-файлы заданной частоты во временной директории."""
    def __init__(self):
        self.temp_dir = tempfile.TemporaryDirectory()
        self.cache = {}

    def get_note_file(self, freq: float, duration: float = 0.6) -> str:
        key = (freq, duration)
        if key in self.cache:
            return self.cache[key]

        sample_rate = 44100
        num_samples = int(sample_rate * duration)
        file_path = os.path.join(self.temp_dir.name, f"note_{freq}_{duration}.wav")

        with wave.open(file_path, 'w') as wav_file:
            wav_file.setnchannels(1)
            wav_file.setsampwidth(2)
            wav_file.setframerate(sample_rate)

            frames = bytearray()
            for i in range(num_samples):
                t = i / sample_rate
                # Плавное затухание звука, имитирующее щипок или удар по струне
                envelope = math.exp(-3.5 * t)
                # Основной тон + легкая гармоника для более приятного тембра
                sample = 0.7 * math.sin(2 * math.pi * freq * t) + 0.3 * math.sin(4 * math.pi * freq * t)
                value = int(32767.0 * 0.5 * envelope * sample)
                frames.extend(struct.pack('<h', value))

            wav_file.writeframes(frames)

        self.cache[key] = file_path
        return file_path


