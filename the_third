    def play_note(self, note_name: str, duration: float = 0.6):
        """Воспроизводит одну ноту."""
        freq = self.notes.get(note_name)
        if not freq:
            return

        wav_path = self.sound_gen.get_note_file(freq, duration)
        sound = QSoundEffect(self)
        sound.setSource(QUrl.fromLocalFile(wav_path))
        sound.setVolume(0.8)
        sound.play()

        self.active_sounds.append(sound)
        if len(self.active_sounds) > 20:
            self.active_sounds.pop(0)

    def play_sequence(self, sequence: list):
        """Воспроизводит список нот с задержками (мелодию)."""
        delay_ms = 0
        for note_name, duration_sec in sequence:
            QTimer.singleShot(delay_ms, lambda n=note_name, d=duration_sec: self.play_note(n, d))
            delay_ms += int(duration_sec * 1000)

    def play_christmas_tree(self):
